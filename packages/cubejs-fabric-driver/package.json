    "@cubejs-backend/shared": "1.6.50",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@cubejs-backend/linter": "1.6.50",
    "@types/mssql": "^9.1.7",
    "@types/node": "^20",
    "typescript": "~5.2.2"
  },
  "jest": {
    "testEnvironment": "node"
  },
  "eslintConfig": {
    "extends": "../cubejs-linter"
