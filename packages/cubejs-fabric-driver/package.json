{
  "name": "@cubejs-backend/fabric-driver",
  "description": "Cube.js Microsoft Fabric Data Warehouse driver",
  "author": "Cube Dev, Inc.",
  "version": "1.6.50",
  "repository": {
    "type": "git",
    "url": "https://github.com/cube-js/cube.git",
    "directory": "packages/cubejs-fabric-driver"
  },
  "engines": {
    "node": "^14.0.0 || ^16.0.0 || >=17.0.0"
  },
  "files": [
